{
  "name": "@hibira-io/push-web",
  "version": "1.3.0",
  "description": "Web push notifications for Hibira Push: a drop-in client for apps moving from Pusher Beams",
  "keywords": [
    "hibira",
    "web push",
    "notification permission",
    "push notifications",
    "service worker"
  ],
  "homepage": "https://hibira.io",
  "bugs": {
    "url": "https://github.com/hibira-io/hibira-push-web/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hibira-io/hibira-push-web.git"
  },
  "license": "MIT",
  "author": "Hibira (https://hibira.io)",
  "type": "module",
  "main": "dist/push-web.js",
  "module": "dist/push-web.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./dist/push-web.js"
    },
    "./service-worker.js": "./dist/service-worker.js"
  },
  "files": [
    "dist",
    "index.d.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node build.mjs && node --test test/*.test.mjs",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "esbuild": "0.25.5",
    "fake-indexeddb": "6.0.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
